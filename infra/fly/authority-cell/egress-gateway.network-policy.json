{
  "name": "egress-gateway-https-only",
  "selector": { "all": true },
  "rules": [
    {
      "action": "allow",
      "direction": "egress",
      "ports": [
        { "protocol": "tcp", "port": 53 },
        { "protocol": "tcp", "port": 443 },
        { "protocol": "udp", "port": 53 }
      ]
    }
  ]
}
