{
  "name": "reelier",
  "version": "0.32.0",
  "mcpName": "io.github.seldonframe/reelier",
  "description": "Agents make claims, Reelier writes receipts - record an agent workflow once, replay it deterministically at 0 tokens, and get an asserted receipt on every run.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "reelier": "dist/cli.js"
  },
  "main": "dist/runner.js",
  "exports": {
    ".": "./dist/runner.js",
    "./skill": "./dist/skill.js",
    "./compile": "./dist/compile.js",
    "./escalate": "./dist/escalate.js",
    "./llm": "./dist/llm.js",
    "./writeback": "./dist/writeback.js",
    "./trace": "./dist/trace.js",
    "./footprint": "./dist/footprint.js",
    "./priors": "./dist/priors.js",
    "./mcp-client": "./dist/mcp-client.js",
    "./mcp-tool": "./dist/mcp-tool.js",
    "./tools": "./dist/tools.js",
    "./serve": "./dist/serve.js",
    "./authority": "./dist/authority/index.js",
    "./authority/pack": "./dist/authority/pack/index.js",
    "./authority/host": "./dist/authority/host/index.js",
    "./observation": "./dist/observation/index.js",
    "./packs": "./dist/packs/index.js",
    "./plugin": "./dist/plugin.js",
    "./bridge": "./dist/bridge.js",
    "./bridge-client": "./dist/bridge-client.js",
    "./contract/*": "./contract/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "integrations",
    "contract"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seldonframe/reelier.git"
  },
  "homepage": "https://github.com/seldonframe/reelier#readme",
  "bugs": {
    "url": "https://github.com/seldonframe/reelier/issues"
  },
  "keywords": [
    "mcp",
    "agent",
    "skills",
    "skill.md",
    "record-replay",
    "deterministic",
    "workflow",
    "automation",
    "claude",
    "llm",
    "mcp-server",
    "testing",
    "snapshot-testing",
    "ci",
    "replay",
    "ai-agents"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-authority-contract.mjs --copy-schemas && node scripts/build-packs.mjs",
    "build:authority-contract": "node scripts/build-authority-contract.mjs",
    "check:authority-contract": "node scripts/build-authority-contract.mjs --check",
    "lint:fault-pins": "node scripts/lint-fault-pins.mjs",
    "baseline": "node scripts/baseline-diff.mjs",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"dist-test/test/**/*.test.js\"",
    "test:coverage": "c8 npm test",
    "test:fuzz": "tsc -p tsconfig.test.json && node scripts/run-fuzz.mjs",
    "test:e2e": "node scripts/e2e-local.mjs",
    "test:mutation": "stryker run",
    "preflight": "node scripts/preflight.mjs",
    "prepublishOnly": "npm run build && npm test",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@types/node": "^20.14.9",
    "c8": "^10.1.3",
    "fast-check": "^4.9.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "3.0.0"
  }
}
