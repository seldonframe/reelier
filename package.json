{
  "name": "@seldonframe/reelier",
  "version": "0.11.0",
  "description": "Agents make claims, Reelier writes receipts - record an agent workflow once, replay it deterministically at 0 tokens, and get an asserted receipt on every run.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "reelier": "dist/cli.js"
  },
  "main": "dist/runner.js",
  "exports": {
    ".": "./dist/runner.js",
    "./skill": "./dist/skill.js",
    "./compile": "./dist/compile.js",
    "./escalate": "./dist/escalate.js",
    "./llm": "./dist/llm.js",
    "./writeback": "./dist/writeback.js",
    "./trace": "./dist/trace.js",
    "./mcp-client": "./dist/mcp-client.js",
    "./mcp-tool": "./dist/mcp-tool.js",
    "./tools": "./dist/tools.js",
    "./serve": "./dist/serve.js"
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "integrations"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seldonframe/reelier.git"
  },
  "homepage": "https://github.com/seldonframe/reelier#readme",
  "bugs": {
    "url": "https://github.com/seldonframe/reelier/issues"
  },
  "keywords": [
    "mcp",
    "agent",
    "skills",
    "skill.md",
    "record-replay",
    "deterministic",
    "workflow",
    "automation",
    "claude",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
