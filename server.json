{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.seldonframe/reelier",
  "title": "Reelier",
  "description": "Snapshot tests and CI for agent workflows: record a run, replay it at 0 tokens, diff for drift.",
  "version": "0.33.0-beta.0",
  "websiteUrl": "https://www.reelier.com",
  "repository": {
    "url": "https://github.com/seldonframe/reelier",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "reelier",
      "version": "0.33.0-beta.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
