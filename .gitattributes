# Freeze the shared wire-contract fixture to LF so its bytes are identical
# across platforms and match the cross-repo sha-lock in
# test/wire-contract.test.ts (and reelier-cloud's copy). Without this a Windows
# working tree checks the file out as CRLF while git/CI/npm see LF.
contract/wire-contract.v1.json text eol=lf
contract/wire-contract.v1.public-key.pem text eol=lf

# Golden-file + skill fixtures are compared as text (renderSkillMd emits LF);
# freeze them to LF so the string/byte-exact tests pass on Windows checkouts
# too. Scoped to text fixtures — NOT the whole test/fixtures/ tree, which may
# hold binary fixtures (e.g. a TSA token) that must not be EOL-converted.
test/fixtures/golden/** text eol=lf
*.skill.md text eol=lf
