{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://reelier.dev/contracts/bootstrap/v1/authority-cell-session-binding.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "cellId", "adapterContractDigest", "authorityContractDigest", "tenant", "principalId", "taskId", "runtimeSessionId", "jobId", "jobCardDigest", "grantId", "grantDigest", "allocationId", "profileDigest", "activationDigest", "profileTrustHeadDigest", "expiresAt", "bindingObservedAt", "bindingFreshUntil", "topologyEvidenceDigest", "topologyFreshUntil"],
  "properties": {
    "v": { "const": "reelier.authority-cell-session-binding/v1" }, "cellId": { "$ref": "#/$defs/id" },
    "adapterContractDigest": { "$ref": "#/$defs/digest" }, "authorityContractDigest": { "$ref": "#/$defs/digest" },
    "tenant": { "$ref": "#/$defs/id" }, "principalId": { "$ref": "#/$defs/id" }, "taskId": { "$ref": "#/$defs/id" },
    "runtimeSessionId": { "$ref": "#/$defs/id" }, "jobId": { "$ref": "#/$defs/id" }, "jobCardDigest": { "$ref": "#/$defs/digest" },
    "grantId": { "$ref": "#/$defs/id" }, "grantDigest": { "$ref": "#/$defs/digest" }, "allocationId": { "$ref": "#/$defs/id" },
    "profileDigest": { "$ref": "#/$defs/digest" }, "activationDigest": { "$ref": "#/$defs/digest" }, "profileTrustHeadDigest": { "$ref": "#/$defs/digest" },
    "expiresAt": { "$ref": "#/$defs/time" }, "bindingObservedAt": { "$ref": "#/$defs/time" }, "bindingFreshUntil": { "$ref": "#/$defs/time" },
    "topologyEvidenceDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "topologyFreshUntil": { "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" }, "digest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" } }
}
