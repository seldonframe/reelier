{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://reelier.dev/contracts/bootstrap/v1/bootstrap-report.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["v", "projectDigest", "runtimeDescriptorDigest", "routeCoverageDigest", "initializedAt", "canary", "authority", "recoveryCommand", "completeness"],
  "properties": {
    "v": { "const": "reelier.bootstrap-report/v1" }, "projectDigest": { "$ref": "#/$defs/digest" },
    "runtimeDescriptorDigest": { "$ref": "#/$defs/digest" }, "routeCoverageDigest": { "$ref": "#/$defs/digest" },
    "initializedAt": { "$ref": "#/$defs/time" }, "canary": { "enum": ["verified", "failed", "unchecked", "absent"] },
    "authority": { "enum": ["activated", "unavailable"] },
    "recoveryCommand": { "type": "string", "pattern": "^npx reelier@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)? up$" },
    "completeness": { "const": "not-proved" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" } }
}
