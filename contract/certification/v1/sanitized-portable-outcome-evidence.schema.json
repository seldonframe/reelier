{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/contracts/certification/v1/sanitized-portable-outcome-evidence.schema.json",
  "title": "Sanitized Portable Outcome Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "privateGraphDigest", "outcomeCollectionDigest", "outcomeCount", "responseSemanticsProfilesDigest", "verifiedAt", "signerId", "signature"],
  "properties": {
    "v": { "const": "reelier.sanitized-portable-outcome-evidence/v1" },
    "privateGraphDigest": { "$ref": "#/$defs/digest" },
    "outcomeCollectionDigest": { "$ref": "#/$defs/digest" },
    "outcomeCount": { "type": "integer", "minimum": 1 },
    "responseSemanticsProfilesDigest": { "$ref": "#/$defs/digest" },
    "verifiedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "signerId": { "$ref": "#/$defs/digest" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
