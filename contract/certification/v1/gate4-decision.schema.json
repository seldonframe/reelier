{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.native-github-gate4-decision/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "state", "candidateDigest", "ubuntuArtifactDigest", "windowsArtifactDigest", "workflowRunId", "ubuntuJobId", "windowsJobId", "decision", "reasons", "liveProviderClaim", "signedAt", "signerId", "signature"],
  "properties": {
    "v": { "const": "reelier.native-github-gate4-decision/v1" },
    "state": { "enum": ["not-run", "insufficient", "failed", "ready-for-founder-decision"] },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "ubuntuArtifactDigest": { "$ref": "#/$defs/digest" },
    "windowsArtifactDigest": { "$ref": "#/$defs/digest" },
    "workflowRunId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "ubuntuJobId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "windowsJobId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$" },
    "decision": { "enum": ["approved", "refused", "blocked"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "liveProviderClaim": { "enum": ["absent", "verified"] },
    "signedAt": { "type": "string", "format": "date-time" },
    "signerId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": { "type": "object", "additionalProperties": false, "required": ["alg", "sig"], "properties": { "alg": { "const": "ed25519" }, "sig": { "type": "string", "contentEncoding": "base64" } } }
  }
}
