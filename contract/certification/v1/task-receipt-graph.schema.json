{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.certification/task-receipt-graph/v1",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "sig": { "type": "string" }
      }
    },
    "signedGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant", "digest", "signerId", "signature"],
      "properties": {
        "grant": { "type": "object" },
        "digest": { "$ref": "#/$defs/digest" },
        "signerId": { "type": "string" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "runtimeSessionId"],
      "properties": {
        "principalId": { "type": "string" },
        "runtimeSessionId": {
          "anyOf": [{ "type": "null" }, { "type": "string" }]
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocationId",
        "taskId",
        "parentAllocationId",
        "effects",
        "reserved",
        "consumed",
        "returned",
        "revoked",
        "remaining"
      ],
      "properties": {
        "allocationId": { "type": "string" },
        "taskId": { "type": "string" },
        "parentAllocationId": {
          "anyOf": [{ "type": "null" }, { "type": "string" }]
        },
        "effects": { "type": "integer", "minimum": 0 },
        "reserved": { "type": "integer", "minimum": 0 },
        "consumed": { "type": "integer", "minimum": 0 },
        "returned": { "type": "integer", "minimum": 0 },
        "revoked": { "type": "boolean" },
        "remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "budgetEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "allocationId",
        "taskId",
        "effects",
        "at",
        "eventDigest"
      ],
      "properties": {
        "v": { "const": "reelier.delegation-budget-event/v1" },
        "type": {
          "enum": ["allocated", "consumed", "returned", "released", "revoked"]
        },
        "allocationId": { "type": "string" },
        "taskId": { "type": "string" },
        "effects": { "type": "integer", "minimum": 0 },
        "reservationId": { "type": "string" },
        "at": { "type": "string" },
        "eventDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "budgetNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "priorBudgetEventDigest", "event"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "priorBudgetEventDigest": { "$ref": "#/$defs/nullableDigest" },
        "event": { "$ref": "#/$defs/budgetEvent" }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "requestId",
        "requestDigest",
        "reservationId",
        "cleanupReservationId",
        "allocationId",
        "effectDigest",
        "permitSnapshotDigest",
        "adapterContractDigest",
        "exactBytesDigest",
        "conflictReceiptDigest",
        "duplicateAttemptHeadDigest",
        "eventSequence",
        "priorJournalDigest",
        "phase",
        "providerWrites",
        "signerId",
        "signature"
      ],
      "properties": {
        "v": { "const": "reelier.github-certification-journal/v1" },
        "requestId": { "type": "string" },
        "requestDigest": { "$ref": "#/$defs/digest" },
        "reservationId": { "type": "string" },
        "cleanupReservationId": {
          "anyOf": [{ "type": "null" }, { "type": "string" }]
        },
        "allocationId": { "type": "string" },
        "effectDigest": { "$ref": "#/$defs/digest" },
        "permitSnapshotDigest": { "$ref": "#/$defs/digest" },
        "adapterContractDigest": { "$ref": "#/$defs/digest" },
        "exactBytesDigest": { "$ref": "#/$defs/nullableDigest" },
        "conflictReceiptDigest": { "$ref": "#/$defs/nullableDigest" },
        "duplicateAttemptHeadDigest": { "$ref": "#/$defs/nullableDigest" },
        "eventSequence": { "type": "integer", "minimum": 0 },
        "priorJournalDigest": { "$ref": "#/$defs/nullableDigest" },
        "phase": {
          "enum": [
            "reserved",
            "budget-intent",
            "budget-consumed",
            "dispatched",
            "provider-send-intent",
            "provider-applied",
            "acknowledged",
            "conflict-publication-pending",
            "conflict",
            "cleanup-reserved",
            "cleanup-budget-consumed",
            "cleanup-dispatched",
            "cleanup-send-intent",
            "cleanup-applied",
            "cleanup-publication-pending",
            "cleanup-receipted",
            "cleanup-refused",
            "refused",
            "failed",
            "pending-reconciliation"
          ]
        },
        "providerWrites": { "type": "integer", "minimum": 0 },
        "signerId": { "type": "string" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "exception": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requestId",
            "exactBytesDigest",
            "receiptDigest"
          ],
          "properties": {
            "kind": { "const": "conflict" },
            "requestId": { "type": "string" },
            "exactBytesDigest": { "$ref": "#/$defs/digest" },
            "receiptDigest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "requestId", "outcomeDigest"],
          "properties": {
            "kind": { "enum": ["failed", "pending-reconciliation"] },
            "requestId": { "type": "string" },
            "outcomeDigest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "signerId", "digest", "value", "signature"],
      "properties": {
        "kind": { "type": "string" },
        "signerId": { "type": "string" },
        "digest": { "$ref": "#/$defs/digest" },
        "value": { "type": "object" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "receiptBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "contract",
        "delegation",
        "sourceBundle",
        "capability",
        "transportEffect",
        "gateEvent",
        "evidence",
        "receipt",
        "packManifest",
        "signatures"
      ],
      "properties": {
        "v": { "const": "reelier.authority-receipt-bundle/v1" },
        "contract": { "$ref": "#/$defs/artifact" },
        "delegation": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "sourceBundle": { "$ref": "#/$defs/artifact" },
        "capability": { "$ref": "#/$defs/artifact" },
        "transportEffect": { "$ref": "#/$defs/artifact" },
        "gateEvent": { "$ref": "#/$defs/artifact" },
        "evidence": { "$ref": "#/$defs/artifact" },
        "receipt": { "$ref": "#/$defs/artifact" },
        "packManifest": { "$ref": "#/$defs/artifact" },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "digest", "signerId", "signature"],
            "properties": {
              "kind": { "type": "string" },
              "digest": { "$ref": "#/$defs/digest" },
              "signerId": { "type": "string" },
              "signature": { "$ref": "#/$defs/signature" }
            }
          }
        }
      }
    },
    "receiptLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptDigest", "priorReceiptDigest"],
      "properties": {
        "receiptDigest": { "$ref": "#/$defs/digest" },
        "priorReceiptDigest": { "$ref": "#/$defs/nullableDigest" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "bindingId",
        "authorityCellId",
        "taskId",
        "adapterContractDigest",
        "readinessDigest",
        "parentEvidenceDescriptorDigest",
        "entries",
        "issuedAt",
        "expiresAt",
        "nonce",
        "scheduleDigest",
        "signerId",
        "signature"
      ],
      "properties": {
        "v": { "const": "reelier.certification-artifact-key-binding/v1" },
        "bindingId": { "type": "string" },
        "authorityCellId": { "type": "string" },
        "taskId": { "type": "string" },
        "adapterContractDigest": { "$ref": "#/$defs/digest" },
        "readinessDigest": { "$ref": "#/$defs/digest" },
        "parentEvidenceDescriptorDigest": { "$ref": "#/$defs/digest" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifactPurpose",
              "keyId",
              "publicKeySpkiBase64",
              "publicKeyDigest"
            ],
            "properties": {
              "artifactPurpose": { "type": "string" },
              "keyId": { "type": "string" },
              "publicKeySpkiBase64": { "type": "string" },
              "publicKeyDigest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "nonce": { "type": "string" },
        "scheduleDigest": { "$ref": "#/$defs/digest" },
        "signerId": { "type": "string" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "bindingCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "bindingDigest",
        "readinessDigest",
        "authorityCellId",
        "taskId",
        "adapterContractDigest",
        "humanSignerId",
        "signature"
      ],
      "properties": {
        "v": {
          "const": "reelier.certification-artifact-key-binding-commitment/v1"
        },
        "bindingDigest": { "$ref": "#/$defs/digest" },
        "readinessDigest": { "$ref": "#/$defs/digest" },
        "authorityCellId": { "type": "string" },
        "taskId": { "type": "string" },
        "adapterContractDigest": { "$ref": "#/$defs/digest" },
        "humanSignerId": { "type": "string" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "keyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "keyId",
        "role",
        "purpose",
        "algorithm",
        "publicKeySpkiBase64"
      ],
      "properties": {
        "v": { "const": "reelier.authority-key-descriptor/v1" },
        "keyId": { "type": "string" },
        "role": { "enum": ["human-sponsor", "authority-cell"] },
        "purpose": { "type": "string" },
        "algorithm": { "const": "ed25519" },
        "publicKeySpkiBase64": { "type": "string" }
      }
    },
    "signedReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "purpose",
        "signerRole",
        "signerKeyId",
        "signerKeyDescriptorDigest",
        "readinessCandidateDigest",
        "configurationRoot",
        "selectionDigest",
        "identifiers",
        "scenarios",
        "activatedCellKeyDescriptorDigests",
        "activatedJobCardKeyDescriptorDigests",
        "trustHistoryDigest",
        "authorizedAt",
        "authorization",
        "dispatchable",
        "completeness",
        "signature"
      ],
      "properties": {
        "v": { "const": "reelier.signed-certification-readiness/v1" },
        "purpose": { "const": "certification-readiness" },
        "signerRole": { "const": "human-sponsor" },
        "signerKeyId": { "type": "string" },
        "signerKeyDescriptorDigest": { "$ref": "#/$defs/digest" },
        "readinessCandidateDigest": { "$ref": "#/$defs/digest" },
        "configurationRoot": { "$ref": "#/$defs/digest" },
        "selectionDigest": { "$ref": "#/$defs/digest" },
        "identifiers": { "type": "object" },
        "scenarios": { "type": "array", "items": { "type": "string" } },
        "activatedCellKeyDescriptorDigests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        },
        "activatedJobCardKeyDescriptorDigests": {
          "type": "array",
          "items": { "$ref": "#/$defs/digest" }
        },
        "trustHistoryDigest": { "$ref": "#/$defs/digest" },
        "authorizedAt": { "type": "string" },
        "authorization": { "const": "human-signed" },
        "dispatchable": { "const": false },
        "completeness": { "const": "unchecked" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "receiptExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "receiptDigest", "adapterContractDigest", "signerId", "signature"],
      "properties": {
        "v": { "const": "reelier.certification-receipt-extension/v1" },
        "receiptDigest": { "$ref": "#/$defs/digest" },
        "adapterContractDigest": { "$ref": "#/$defs/digest" },
        "signerId": { "type": "string" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "taskAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["v","taskId","signedJobCard","activation","dispatchSnapshotPreimage","operatorConfigDigest","taskShapeDigest","instructionsDigest","runnerDigest","planDigest","endpointDigest","sourceDigest","policyDigest","principalSessionDigest","grantAllocationDigest","trustHeadDigest","declaredIntent","declaredTrigger","signedJobCardDigest","activationDigest","dispatchSnapshotDigest","adapterContractDigest","intentDigest","triggerDigest","signerId","signature"],
      "properties": {
        "v": { "const": "reelier.certification-task-authority-evidence/v1" }, "taskId": { "type": "string" }, "signedJobCard": { "type": "object" }, "activation": { "type": "object" }, "dispatchSnapshotPreimage": { "type": "object" },
        "operatorConfigDigest": { "$ref": "#/$defs/digest" }, "taskShapeDigest": { "$ref": "#/$defs/digest" }, "instructionsDigest": { "$ref": "#/$defs/digest" }, "runnerDigest": { "$ref": "#/$defs/digest" }, "planDigest": { "$ref": "#/$defs/digest" }, "endpointDigest": { "$ref": "#/$defs/digest" }, "sourceDigest": { "$ref": "#/$defs/digest" }, "policyDigest": { "$ref": "#/$defs/digest" }, "principalSessionDigest": { "$ref": "#/$defs/digest" }, "grantAllocationDigest": { "$ref": "#/$defs/digest" }, "trustHeadDigest": { "$ref": "#/$defs/digest" }, "declaredIntent": { "type": "object" }, "declaredTrigger": { "type": "object" }, "intentDigest": { "$ref": "#/$defs/digest" }, "triggerDigest": { "$ref": "#/$defs/digest" }, "signedJobCardDigest": { "$ref": "#/$defs/digest" }, "activationDigest": { "$ref": "#/$defs/digest" }, "dispatchSnapshotDigest": { "$ref": "#/$defs/digest" }, "adapterContractDigest": { "$ref": "#/$defs/digest" }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "postStateEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["v","requestId","dispatchRequestDigest","permitSnapshotDigest","expectedProjectionDigest","preSourceBundleDigest","projectionSchemaId","projectionSchemaDigest","preProjectionDigest","observedProjectionDigest","observationMethod","observedAt","confidence","signerId","signature"],
      "properties": {
        "v": { "const": "reelier.certification-post-state-evidence/v1" }, "requestId": { "type": "string" }, "dispatchRequestDigest": { "$ref": "#/$defs/digest" }, "permitSnapshotDigest": { "$ref": "#/$defs/digest" }, "expectedProjectionDigest": { "$ref": "#/$defs/digest" }, "preSourceBundleDigest": { "$ref": "#/$defs/nullableDigest" }, "projectionSchemaId": { "type": "string" }, "projectionSchemaDigest": { "$ref": "#/$defs/digest" }, "preProjectionDigest": { "$ref": "#/$defs/nullableDigest" }, "observedProjectionDigest": { "$ref": "#/$defs/nullableDigest" }, "observationMethod": { "enum": ["hermetic-authoritative-read","provider-acknowledgment","not-observed"] }, "observedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "confidence": { "enum": ["exact","partial"] }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "policyEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["v","artifact","status","schemaId","jcsBase64","policyDigest","authorityStatePreimage","authorityStateDigest","signerId","signature"],
      "properties": { "v": { "const": "reelier.certification-policy-evidence/v1" }, "artifact": { "enum": ["outcome-contract","local-gate-policy"] }, "status": { "enum": ["verified","failed","unchecked","absent"] }, "schemaId": { "type": ["string","null"] }, "jcsBase64": { "type": ["string","null"] }, "policyDigest": { "$ref": "#/$defs/digest" }, "authorityStatePreimage": { "type": ["object","null"] }, "authorityStateDigest": { "$ref": "#/$defs/nullableDigest" }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "taskStatusEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["v","phase","taskId","lifecycleState","grantExpiresAt","allocationRevoked","observedAt","durableHistoryDigest","currentActiveClaim","freshness","signerId","signature"],
      "properties": { "v": { "const": "reelier.certification-task-status-evidence/v1" }, "phase": { "enum": ["dispatch","export"] }, "taskId": { "type": "string" }, "lifecycleState": { "enum": ["active","revoked","expired","inactive"] }, "grantExpiresAt": { "type": "string" }, "allocationRevoked": { "type": "boolean" }, "observedAt": { "type": "string" }, "durableHistoryDigest": { "$ref": "#/$defs/digest" }, "currentActiveClaim": { "type": "boolean" }, "freshness": { "const": "unchecked" }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "duplicateDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["v","attemptId","attemptRequestId","operationKind","originalRequestId","originalRequestDigest","originalEffectDigest","observedAuthorityState","observedAuthorityStateDigest","observedAt","budgetDelta","providerWriteDelta","signerId","signature"],
      "properties": { "v": { "const": "reelier.certification-duplicate-decision/v1" }, "attemptId": { "type": "string" }, "attemptRequestId": { "type": "string" }, "operationKind": { "enum": ["run","conflict","cleanup"] }, "originalRequestId": { "type": "string" }, "originalRequestDigest": { "$ref": "#/$defs/digest" }, "originalEffectDigest": { "$ref": "#/$defs/digest" }, "observedAuthorityState": { "type": "object" }, "observedAuthorityStateDigest": { "$ref": "#/$defs/digest" }, "observedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "budgetDelta": { "const": 0 }, "providerWriteDelta": { "const": 0 }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "duplicateAttempt": {
      "type": "object", "additionalProperties": false,
      "required": ["v","attemptId","attemptRequestId","operationKind","originalRequestId","observedAuthorityStateDigest","observedAt","signerId","signature"],
      "properties": { "v": { "const": "reelier.certification-duplicate-attempt/v1" }, "attemptId": { "type": "string" }, "attemptRequestId": { "type": "string" }, "operationKind": { "enum": ["run","conflict","cleanup"] }, "originalRequestId": { "type": "string" }, "observedAuthorityStateDigest": { "$ref": "#/$defs/digest" }, "observedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "duplicateAttemptHead": {
      "type": "object", "additionalProperties": false,
      "required": ["v","sequence","previousHeadDigest","count","historyDigest","decisionHistoryDigest","signerId","signature"],
      "properties": { "v": { "const": "reelier.certification-duplicate-attempt-head/v1" }, "sequence": { "type": "integer", "minimum": 0 }, "previousHeadDigest": { "$ref": "#/$defs/nullableDigest" }, "count": { "type": "integer", "minimum": 0 }, "historyDigest": { "$ref": "#/$defs/digest" }, "decisionHistoryDigest": { "$ref": "#/$defs/digest" }, "signerId": { "type": "string" }, "signature": { "$ref": "#/$defs/signature" } }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants",
        "principals",
        "allocations",
        "budgetEvents",
        "outcomes",
        "exceptions",
        "topologyEvidence",
        "leases",
        "receipts",
        "receiptExtensions",
        "taskAuthorities",
        "postStateEvidence",
        "policyEvidence",
        "taskStatusEvidence",
        "duplicateAttempts",
        "duplicateDecisions",
        "priorReceiptLinks",
        "keyDescriptors",
        "bindingEntries"
      ],
      "properties": {
        "grants": { "type": "integer", "minimum": 0 },
        "principals": { "type": "integer", "minimum": 0 },
        "allocations": { "type": "integer", "minimum": 0 },
        "budgetEvents": { "type": "integer", "minimum": 0 },
        "outcomes": { "type": "integer", "minimum": 0 },
        "exceptions": { "type": "integer", "minimum": 0 },
        "topologyEvidence": { "const": 0 },
        "leases": { "const": 0 },
        "receipts": { "type": "integer", "minimum": 0 },
        "receiptExtensions": { "type": "integer", "minimum": 0 },
        "taskAuthorities": { "type": "integer", "minimum": 0 },
        "postStateEvidence": { "type": "integer", "minimum": 0 },
        "policyEvidence": { "type": "integer", "minimum": 0 },
        "taskStatusEvidence": { "type": "integer", "minimum": 0 },
        "duplicateAttempts": { "type": "integer", "minimum": 0 },
        "duplicateDecisions": { "type": "integer", "minimum": 0 },
        "priorReceiptLinks": { "type": "integer", "minimum": 0 },
        "keyDescriptors": { "type": "integer", "minimum": 0 },
        "bindingEntries": { "type": "integer", "minimum": 0 }
      }
    },
    "collectionDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants",
        "principals",
        "allocations",
        "budgetEvents",
        "outcomes",
        "exceptions",
        "receipts",
        "receiptExtensions",
        "taskAuthorities",
        "postStateEvidence",
        "policyEvidence",
        "taskStatusEvidence",
        "duplicateAttempts",
        "duplicateDecisions",
        "priorReceiptLinks",
        "keyDescriptors"
      ],
      "properties": {
        "grants": { "$ref": "#/$defs/digest" },
        "principals": { "$ref": "#/$defs/digest" },
        "allocations": { "$ref": "#/$defs/digest" },
        "budgetEvents": { "$ref": "#/$defs/digest" },
        "outcomes": { "$ref": "#/$defs/digest" },
        "exceptions": { "$ref": "#/$defs/digest" },
        "receipts": { "$ref": "#/$defs/digest" },
        "receiptExtensions": { "$ref": "#/$defs/digest" },
        "taskAuthorities": { "$ref": "#/$defs/digest" },
        "postStateEvidence": { "$ref": "#/$defs/digest" },
        "policyEvidence": { "$ref": "#/$defs/digest" },
        "taskStatusEvidence": { "$ref": "#/$defs/digest" },
