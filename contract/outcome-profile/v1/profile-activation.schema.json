{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.outcome-profile/profile-activation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "tenant", "activationId", "profileDigest", "conformanceDigest", "jobCardDigest", "contractDigest", "deploymentDigest", "routeAuthorityDigest", "trustHeadDigest", "validFrom", "validUntil", "state", "signerId", "signature"],
  "properties": {
    "v": { "const": "reelier.outcome-profile-activation/v1" },
    "tenant": { "$ref": "#/$defs/id" },
    "activationId": { "$ref": "#/$defs/id" },
    "profileDigest": { "$ref": "#/$defs/digest" },
    "conformanceDigest": { "$ref": "#/$defs/digest" },
    "jobCardDigest": { "$ref": "#/$defs/digest" },
    "contractDigest": { "$ref": "#/$defs/digest" },
    "deploymentDigest": { "$ref": "#/$defs/digest" },
    "routeAuthorityDigest": { "$ref": "#/$defs/digest" },
    "trustHeadDigest": { "$ref": "#/$defs/digest" },
    "validFrom": { "$ref": "#/$defs/time" },
    "validUntil": { "$ref": "#/$defs/time" },
    "state": { "enum": ["activated", "revoked"] },
    "signerId": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
    "digest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
