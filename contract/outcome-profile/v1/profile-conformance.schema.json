{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/contracts/outcome-profile/v1/profile-conformance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "tenant", "profileDigest", "packDigest", "definitionDigest", "definitionRegistrationDigest", "harnessId", "harnessDigest", "vectorSetDigest", "reportDigest", "sourceRevision", "claims", "signerId", "signature"],
  "properties": {
    "v": { "const": "reelier.outcome-profile-conformance/v1" },
    "tenant": { "$ref": "#/$defs/id" },
    "profileDigest": { "$ref": "#/$defs/digest" },
    "packDigest": { "$ref": "#/$defs/digest" },
    "definitionDigest": { "$ref": "#/$defs/digest" },
    "definitionRegistrationDigest": { "$ref": "#/$defs/digest" },
    "harnessId": { "$ref": "#/$defs/id" },
    "harnessDigest": { "$ref": "#/$defs/digest" },
    "vectorSetDigest": { "$ref": "#/$defs/digest" },
    "reportDigest": { "$ref": "#/$defs/digest" },
    "sourceRevision": { "type": "string", "pattern": "^[A-Za-z0-9._/~+-]{1,160}$" },
    "claims": { "$ref": "#/$defs/claims" },
    "signerId": { "$ref": "#/$defs/id" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
    "digest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" },
    "claim": { "enum": ["verified", "failed", "unchecked", "absent"] },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closure", "determinism", "accountBinding", "noSecrets", "reconciliation"],
      "properties": {
        "closure": { "$ref": "#/$defs/claim" },
        "determinism": { "$ref": "#/$defs/claim" },
        "accountBinding": { "$ref": "#/$defs/claim" },
        "noSecrets": { "$ref": "#/$defs/claim" },
        "reconciliation": { "$ref": "#/$defs/claim" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "sig"],
      "properties": {
        "alg": { "const": "ed25519" },
        "sig": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
