{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/contracts/outcome-profile/v1/profile-trust-pin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "tenant", "governanceRef", "certifier", "operator", "currentTrustEvents", "currentTrustEventsDigest", "trustHeadDigest"],
  "properties": {
    "v": { "const": "reelier.outcome-profile-trust-pin/v1" },
    "tenant": { "$ref": "#/$defs/id" },
    "governanceRef": { "$ref": "#/$defs/id" },
    "certifier": { "$ref": "#/$defs/certifier" },
    "operator": { "$ref": "#/$defs/operator" },
    "currentTrustEvents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "currentTrustEventsDigest": { "$ref": "#/$defs/digest" },
    "trustHeadDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
    "digest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$" },
    "rootBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "purpose", "publicKeySpkiBase64"],
      "properties": {
        "signerId": { "$ref": "#/$defs/id" },
        "purpose": { "enum": ["profile-conformance", "profile-activation"] },
        "publicKeySpkiBase64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "certifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "purpose", "publicKeySpkiBase64"],
      "properties": {
        "signerId": { "$ref": "#/$defs/id" },
        "purpose": { "const": "profile-conformance" },
        "publicKeySpkiBase64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "purpose", "publicKeySpkiBase64"],
      "properties": {
        "signerId": { "$ref": "#/$defs/id" },
        "purpose": { "const": "profile-activation" },
        "publicKeySpkiBase64": { "type": "string", "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "action", "keyPurpose", "keyDigest", "at", "previousHeadDigest"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "action": { "enum": ["activate", "revoke"] },
        "keyPurpose": { "enum": ["profile-conformance", "profile-activation"] },
        "keyDigest": { "$ref": "#/$defs/digest" },
        "at": { "$ref": "#/$defs/time" },
        "previousHeadDigest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      }
    }
  }
}
