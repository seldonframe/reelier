{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"reelier.authority/authority-evidence/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["v","evidenceId","receiptId","decisionContextDigest","gateEventDigest","effectDigest","reservationId","timeline","dispatchedRequestDigest","providerResponseDigest","reconciliation","topology"],
  "properties":{
    "v":{"const":"reelier.authority-evidence/v1"},
    "evidenceId":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},
    "receiptId":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},
    "decisionContextDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "gateEventDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "effectDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "reservationId":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},
    "timeline":{
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["state","at","eventDigest"],"properties":{
        "state":{"enum":["reserved","dispatched","acknowledged","definitive-failure","ambiguous","reconciled","cancelled"]},
        "at":{"type":"string","format":"date-time"},
        "eventDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}
      }}
    },
    "dispatchedRequestDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},
    "providerResponseDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},
    "reconciliation":{
      "type":"object","additionalProperties":false,"required":["recipeId","verdict","normalizedProjectionDigest"],
      "properties":{
        "recipeId":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},
        "verdict":{"enum":["matched","not-applied","conflict","unavailable","not-attempted"]},
        "normalizedProjectionDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]}
      }
    },
    "topology":{
      "type":"object","additionalProperties":false,"required":["egress","secretIsolation","ingressAuthentication","notes"],
      "properties":{
        "egress":{"enum":["verified","failed","unchecked","absent"]},
        "secretIsolation":{"enum":["verified","failed","unchecked","absent"]},
        "ingressAuthentication":{"enum":["verified","failed","unchecked","absent"]},
        "notes":{"anyOf":[{"type":"null"},{"type":"string","maxLength":1024}]}
      }
    }
  }
}
