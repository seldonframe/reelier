{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.authority/delegation-grant/v1",
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,128}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "pointer": { "type": "string", "maxLength": 512, "pattern": "^(?:/(?:[^~/]|~[01])*)+$" },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxEffectsPerWindow", "windowSeconds", "maxEffectsPerSourceTrigger", "maxBodyBytes"],
      "properties": {
        "maxEffectsPerWindow": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "windowSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "maxEffectsPerSourceTrigger": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maxBodyBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 }
      }
    },
    "delegationPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mayDelegate", "maxDepth", "maxFanOut", "maxChildDurationSeconds", "maxDelegatedEffects"],
      "properties": {
        "mayDelegate": { "type": "boolean" },
        "maxDepth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "maxFanOut": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "maxChildDurationSeconds": { "type": "integer", "minimum": 1, "maximum": 31536000 },
        "maxDelegatedEffects": { "type": "integer", "minimum": 0, "maximum": 1000000 }
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["v", "tenant", "grantId", "parentDigest", "sponsor", "grantor", "grantee", "issuedAt", "expiresAt", "constraints"],
  "properties": {
    "v": { "const": "reelier.delegation-grant/v1" }, "tenant": { "$ref": "#/$defs/id" }, "grantId": { "$ref": "#/$defs/id" },
    "parentDigest": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "delegationPolicy": { "$ref": "#/$defs/delegationPolicy" },
    "sponsor": { "$ref": "#/$defs/id" }, "grantor": { "$ref": "#/$defs/id" }, "grantee": { "$ref": "#/$defs/id" },
    "issuedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["definitionAliases", "audiences", "connectorAccounts", "projectionPointers", "riskClasses", "limits"],
      "properties": {
        "definitionAliases": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" } },
        "audiences": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "connectorAccounts": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["connectorId", "accountId"], "properties": { "connectorId": { "$ref": "#/$defs/id" }, "accountId": { "$ref": "#/$defs/id" } } } },
        "projectionPointers": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/pointer" } },
        "riskClasses": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "limits": { "$ref": "#/$defs/limits" }
      }
    }
  }
}
