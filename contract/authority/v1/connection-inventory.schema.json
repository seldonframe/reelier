{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.connection-inventory/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "root", "entries", "issues"],
  "properties": {
    "v": { "const": "reelier.connection-inventory/v1" },
    "root": { "type": "string" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "reasonCode"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "reasonCode": { "const": "malformed-inventory-entry" }
        }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "discoveryId", "provider", "connectionKind", "status", "routeStatus", "accountVerification", "schemaVerification", "reasonCodes"],
      "properties": {
        "v": { "const": "reelier.connection-inventory-entry/v1" },
        "discoveryId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "connectionKind": { "enum": ["adopted-mcp-stdio", "adopted-mcp-http", "composio-managed", "native-https", "host-private"] },
        "status": { "enum": ["usable", "discovered-unverified", "schema-drifted", "account-mismatched", "shadow-only", "unsupported"] },
        "routeStatus": { "enum": ["callable", "host-private", "unsupported"] },
        "accountVerification": { "$ref": "#/$defs/accountVerification" },
        "schemaVerification": { "$ref": "#/$defs/schemaVerification" },
        "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "descriptor": { "$ref": "#/$defs/descriptor" }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "usable" } }, "required": ["status"] },
        "then": { "properties": { "descriptor": {} }, "required": ["descriptor"] },
        "else": { "not": { "properties": { "descriptor": {} }, "required": ["descriptor"] } }
      }]
    },
    "accountVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["verified", "unverified", "mismatched", "unsupported"] },
        "identity": { "type": "string", "minLength": 1 },
        "expectedIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "schemaVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "expectedDigests", "observedDigests"],
      "properties": {
        "status": { "enum": ["verified", "unverified", "drifted", "unsupported"] },
        "expectedDigests": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
        "observedDigests": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "connectionId", "kind", "provider", "callableRoute", "account", "toolSchemas", "secretOwner", "coverage"],
      "properties": {
        "v": { "const": "reelier.connection-descriptor/v1" },
        "connectionId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["adopted-mcp-stdio", "adopted-mcp-http", "composio-managed", "native-https", "host-private"] },
        "provider": {
          "type": "object", "additionalProperties": false, "required": ["id", "toolServerName"],
          "properties": { "id": { "type": "string", "minLength": 1 }, "toolServerName": { "type": "string", "minLength": 1 } }
        },
        "callableRoute": {
          "type": "object", "additionalProperties": false, "required": ["kind", "routeId", "endpointIds"],
          "properties": {
            "kind": { "enum": ["mcp-stdio", "mcp-http", "opaque-host"] },
            "routeId": { "type": "string", "minLength": 1 },
            "endpointIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "account": {
          "type": "object", "additionalProperties": false, "required": ["status", "identity"],
          "properties": { "status": { "const": "verified" }, "identity": { "type": "string", "minLength": 1 } }
        },
        "toolSchemas": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["toolName", "digest"],
            "properties": { "toolName": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
          }
        },
        "secretOwner": { "enum": ["host", "provider", "worker"] },
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["v", "host", "observation", "outcomeInvocation", "exclusiveEnforcement", "limitations"],
          "properties": {
            "v": { "const": "reelier.host-coverage/v1" },
            "host": { "type": "string", "minLength": 1 },
            "observation": { "enum": ["observed", "partially_observed", "uncovered", "unknown"] },
            "outcomeInvocation": { "enum": ["supported", "unsupported", "unknown"] },
            "exclusiveEnforcement": { "enum": ["declared-surface", "not-declared", "unknown"] },
            "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
