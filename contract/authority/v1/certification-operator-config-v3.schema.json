{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.authority/certification-operator-config/v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "authorityConfigPath", "evidenceDirectory", "scenarios", "resources", "cleanup", "metadata", "secretReferences"],
  "properties": {
    "v": { "const": "reelier.certification-operator-config/v3" },
    "authorityConfigPath": { "$ref": "#/$defs/localText" },
    "evidenceDirectory": { "$ref": "#/$defs/localText" },
    "scenarios": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["cloudflare-dns", "cloudflare-vercel-secret", "codex-ten-principal", "fly-topology", "github-issue-labels", "neon-migration", "slack-topic", "vercel-promotion"] } },
    "resources": { "type": "object", "additionalProperties": false, "properties": { "cloudflare-dns": { "type": "object" }, "cloudflare-vercel-secret": { "type": "object" }, "github-issue-labels": { "type": "object" }, "neon-migration": { "type": "object" }, "slack-topic": { "type": "object" }, "vercel-promotion": { "type": "object" } } },
    "cleanup": { "type": "object", "additionalProperties": false, "properties": { "cloudflare-dns": { "$ref": "#/$defs/idList" }, "cloudflare-vercel-secret": { "$ref": "#/$defs/idList" }, "github-issue-labels": { "$ref": "#/$defs/idList" }, "neon-migration": { "$ref": "#/$defs/idList" }, "slack-topic": { "$ref": "#/$defs/idList" }, "vercel-promotion": { "$ref": "#/$defs/idList" } } },
    "desiredState": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "github-issue-labels": { "type": "object", "additionalProperties": false, "required": ["labels"], "properties": { "labels": { "$ref": "#/$defs/idList" } } },
        "cloudflare-dns": { "type": "object", "additionalProperties": false, "required": ["type", "content", "ttl", "proxied"], "properties": { "type": { "enum": ["A", "AAAA", "CNAME", "TXT"] }, "content": { "type": "string", "minLength": 1, "maxLength": 2048 }, "ttl": { "type": "integer", "minimum": 1 }, "proxied": { "type": "boolean" } } },
        "slack-topic": { "type": "object", "additionalProperties": false, "required": ["topic"], "properties": { "topic": { "type": "string", "minLength": 1, "maxLength": 250 } } },
        "cloudflare-vercel-secret": { "type": "object", "additionalProperties": false, "required": ["cloudflare", "vercel"], "properties": { "cloudflare": { "type": "object", "additionalProperties": false, "required": ["permissionGroupIds", "resources", "notBefore", "expiresAt", "requestIpIn", "requestIpNotIn"], "properties": { "permissionGroupIds": { "$ref": "#/$defs/idList" }, "resources": { "type": "object", "minProperties": 1, "maxProperties": 16, "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/id" } }, "notBefore": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" }, "requestIpIn": { "$ref": "#/$defs/textList" }, "requestIpNotIn": { "$ref": "#/$defs/textList" } } }, "vercel": { "type": "object", "additionalProperties": false, "required": ["environment", "key"], "properties": { "environment": { "enum": ["production", "preview"] }, "key": { "$ref": "#/$defs/id" } } } } },
        "vercel-promotion": { "type": "object", "additionalProperties": false, "required": ["deploymentId", "domains"], "properties": { "deploymentId": { "$ref": "#/$defs/id" }, "domains": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "format": "hostname" } } },
        "neon-migration": { "type": "object", "additionalProperties": false, "required": ["migrationId", "sql", "expectedSchemaDigest"], "properties": { "migrationId": { "$ref": "#/$defs/id" }, "sql": { "type": "string", "minLength": 1, "maxLength": 100000 }, "expectedSchemaDigest": { "$ref": "#/$defs/digest" } } }
      }
    },
    "metadata": { "type": "object", "additionalProperties": false, "properties": { "flyTopology": { "type": "object" }, "codexTenPrincipal": { "type": "object" } } },
    "secretReferences": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "cloudflareBootstrapCredential": { "$ref": "#/$defs/secretReference" },
        "cloudflareDnsCredential": { "$ref": "#/$defs/secretReference" },
        "flyApiCredential": { "$ref": "#/$defs/secretReference" },
        "githubCredential": { "$ref": "#/$defs/secretReference" },
        "neonApiCredential": { "$ref": "#/$defs/secretReference" },
        "neonDatabaseUrl": { "$ref": "#/$defs/secretReference" },
        "slackCredential": { "$ref": "#/$defs/secretReference" },
        "vercelCredential": { "$ref": "#/$defs/secretReference" }
      }
    }
  },
  "$defs": {
    "localText": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "^(?:https?:|file:)" } },
    "secretReference": { "type": "string", "pattern": "^(?:env:[A-Z][A-Z0-9_]{1,127}|file:[^\\r\\n\\u0000]{1,2048})$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "textList": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "idList": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
