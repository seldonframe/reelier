    "neonResource": { "type": "object", "additionalProperties": false, "required": ["apiBaseUrl", "accountId", "projectId", "branchId", "database", "role"], "properties": { "apiBaseUrl": { "const": "https://console.neon.tech/api/v2" }, "accountId": { "$ref": "#/$defs/id" }, "projectId": { "$ref": "#/$defs/id" }, "branchId": { "$ref": "#/$defs/id" }, "database": { "$ref": "#/$defs/id" }, "role": { "$ref": "#/$defs/id" } } },
    "flyTopology": { "type": "object", "additionalProperties": false, "required": ["appName", "authorityMachineId", "agentAppName", "agentMachineId", "egressAppName", "egressMachineId", "orgSlug", "region", "flyctlPath", "flyctlVersion", "egressProxyBaseUrl", "authorityImageDigest", "agentImageDigest", "gatewayImageDigest", "networkPolicyDigest", "schemaDigest"], "properties": { "appName": { "$ref": "#/$defs/id" }, "authorityMachineId": { "$ref": "#/$defs/id" }, "agentAppName": { "$ref": "#/$defs/id" }, "agentMachineId": { "$ref": "#/$defs/id" }, "egressAppName": { "$ref": "#/$defs/id" }, "egressMachineId": { "$ref": "#/$defs/id" }, "orgSlug": { "$ref": "#/$defs/id" }, "region": { "$ref": "#/$defs/id" }, "flyctlPath": { "$ref": "#/$defs/localText" }, "flyctlVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }, "egressProxyBaseUrl": { "type": "string", "pattern": "^http://[A-Za-z0-9][A-Za-z0-9._~-]{0,127}\\.internal:8443$" }, "authorityImageDigest": { "$ref": "#/$defs/digest" }, "agentImageDigest": { "$ref": "#/$defs/digest" }, "gatewayImageDigest": { "$ref": "#/$defs/digest" }, "networkPolicyDigest": { "$ref": "#/$defs/digest" }, "schemaDigest": { "$ref": "#/$defs/digest" } } },
