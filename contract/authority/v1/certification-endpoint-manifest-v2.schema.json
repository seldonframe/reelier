{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.authority/certification-endpoint-manifest/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "scenarioId", "definitionAliases", "endpoints", "completeness", "dispatchable"],
  "properties": {
    "v": { "const": "reelier.certification-endpoint-manifest/v2" },
    "scenarioId": { "enum": ["cloudflare-dns", "cloudflare-vercel-secret", "github-issue-labels", "neon-migration", "slack-topic", "vercel-promotion"] },
    "definitionAliases": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" } },
    "endpoints": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/endpoint" } },
    "completeness": { "const": "unchecked" },
    "dispatchable": { "const": false }
  },
  "allOf": [
    { "if": { "properties": { "scenarioId": { "const": "cloudflare-dns" } } }, "then": { "properties": { "definitionAliases": { "const": ["cloudflare_dns_record_set_v1"] }, "endpoints": { "minItems": 2, "maxItems": 2, "prefixItems": [{"properties":{"endpointId":{"const":"cloudflare.dns.record.get"},"provider":{"const":"cloudflare"},"credentialSlot":{"const":"cloudflareDnsCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"cloudflare.dns.record.set"},"provider":{"const":"cloudflare"},"credentialSlot":{"const":"cloudflareDnsCredential"},"direction":{"const":"write"},"method":{"const":"PUT"}}}] } } } },
    { "if": { "properties": { "scenarioId": { "const": "cloudflare-vercel-secret" } } }, "then": { "properties": { "definitionAliases": { "const": ["cloudflare_api_token_create_v1","vercel_project_environment_secret_set_v1"] }, "endpoints": { "minItems": 4, "maxItems": 4, "prefixItems": [{"properties":{"endpointId":{"const":"cloudflare.api_token.find"},"provider":{"const":"cloudflare"},"credentialSlot":{"const":"cloudflareBootstrapCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"cloudflare.api_token.create"},"provider":{"const":"cloudflare"},"credentialSlot":{"const":"cloudflareBootstrapCredential"},"direction":{"const":"write"},"method":{"const":"POST"}}},{"properties":{"endpointId":{"const":"vercel.project.environment.secret.get"},"provider":{"const":"vercel"},"credentialSlot":{"const":"vercelCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"vercel.project.environment.secret.set"},"provider":{"const":"vercel"},"credentialSlot":{"const":"vercelCredential"},"direction":{"const":"write"},"method":{"const":"POST"}}}] } } } },
    { "if": { "properties": { "scenarioId": { "const": "github-issue-labels" } } }, "then": { "properties": { "definitionAliases": { "const": ["github_issue_labels_set_v1"] }, "endpoints": { "minItems": 2, "maxItems": 2, "prefixItems": [{"properties":{"endpointId":{"const":"github.issue.get"},"provider":{"const":"github"},"credentialSlot":{"const":"githubCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"github.issue.labels.replace"},"provider":{"const":"github"},"credentialSlot":{"const":"githubCredential"},"direction":{"const":"write"},"method":{"const":"PUT"}}}] } } } },
    { "if": { "properties": { "scenarioId": { "const": "neon-migration" } } }, "then": { "properties": { "definitionAliases": { "const": ["neon_database_migration_apply_v1"] }, "endpoints": { "minItems": 2, "maxItems": 2, "prefixItems": [{"properties":{"endpointId":{"const":"neon.database.catalog.get"},"provider":{"const":"neon"},"credentialSlot":{"const":"neonApiCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"neon.database.migration.apply"},"provider":{"const":"neon"},"credentialSlot":{"const":"neonDatabaseUrl"},"direction":{"const":"write"},"method":{"const":"POST"}}}] } } } },
    { "if": { "properties": { "scenarioId": { "const": "slack-topic" } } }, "then": { "properties": { "definitionAliases": { "const": ["slack_channel_topic_set_v1"] }, "endpoints": { "minItems": 2, "maxItems": 2, "prefixItems": [{"properties":{"endpointId":{"const":"slack.conversations.info"},"provider":{"const":"slack"},"credentialSlot":{"const":"slackCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"slack.conversations.setTopic"},"provider":{"const":"slack"},"credentialSlot":{"const":"slackCredential"},"direction":{"const":"write"},"method":{"const":"POST"}}}] } } } },
    { "if": { "properties": { "scenarioId": { "const": "vercel-promotion" } } }, "then": { "properties": { "definitionAliases": { "const": ["vercel_deployment_release_v1"] }, "endpoints": { "minItems": 2, "maxItems": 2, "prefixItems": [{"properties":{"endpointId":{"const":"vercel.deployment.get"},"provider":{"const":"vercel"},"credentialSlot":{"const":"vercelCredential"},"direction":{"const":"read"},"method":{"const":"GET"}}},{"properties":{"endpointId":{"const":"vercel.deployment.promote"},"provider":{"const":"vercel"},"credentialSlot":{"const":"vercelCredential"},"direction":{"const":"write"},"method":{"const":"POST"}}}] } } } }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["endpointId", "provider", "credentialSlot", "accountCommitment", "resourceCommitment", "direction", "method"],
      "properties": {
        "endpointId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "provider": { "enum": ["cloudflare", "github", "neon", "slack", "vercel"] },
        "credentialSlot": { "enum": ["cloudflareBootstrapCredential", "cloudflareDnsCredential", "githubCredential", "neonApiCredential", "neonDatabaseUrl", "slackCredential", "vercelCredential"] },
        "accountCommitment": { "$ref": "#/$defs/digest" },
        "resourceCommitment": { "$ref": "#/$defs/digest" },
        "direction": { "enum": ["read", "write"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }
      }
    }
  }
}
