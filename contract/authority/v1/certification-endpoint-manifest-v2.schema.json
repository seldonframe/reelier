{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.authority/certification-endpoint-manifest/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "scenarioId", "definitionAliases", "endpoints", "completeness", "dispatchable"],
  "properties": {
    "v": { "const": "reelier.certification-endpoint-manifest/v2" },
    "scenarioId": { "enum": ["cloudflare-dns", "cloudflare-vercel-secret", "github-issue-labels", "neon-migration", "slack-topic", "vercel-promotion"] },
    "definitionAliases": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" } },
    "endpoints": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/endpoint" } },
    "completeness": { "const": "unchecked" },
    "dispatchable": { "const": false }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["endpointId", "provider", "credentialSlot", "accountCommitment", "resourceCommitment", "direction", "method"],
      "properties": {
        "endpointId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$" },
        "provider": { "enum": ["cloudflare", "github", "neon", "slack", "vercel"] },
        "credentialSlot": { "enum": ["cloudflareBootstrapCredential", "cloudflareDnsCredential", "githubCredential", "neonApiCredential", "neonDatabaseUrl", "slackCredential", "vercelCredential"] },
        "accountCommitment": { "$ref": "#/$defs/digest" },
        "resourceCommitment": { "$ref": "#/$defs/digest" },
        "direction": { "enum": ["read", "write"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }
      }
    }
  }
}
