{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.authority/certification-scenario-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "scenarioId", "definitionAliases", "sourceRefs", "choices", "policyCommitments", "cleanup", "controlledCut", "runnerManifestDigest", "testManifestDigest", "endpointManifestDigest", "runnerRegistryDigest"],
  "properties": {
    "v": { "const": "reelier.certification-scenario-plan/v1" },
    "scenarioId": { "enum": ["cloudflare-dns", "cloudflare-vercel-secret", "github-issue-labels", "neon-migration", "slack-topic", "vercel-promotion"] },
    "definitionAliases": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" } },
    "sourceRefs": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z][a-z0-9_]{2,127}$" }, "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/#-]{0,511}$" } },
    "choices": { "type": "object", "propertyNames": { "not": { "pattern": "(?i:secret|token|password|authorization|cookie|callback|function|module|path|command|sourcecode|code)" } }, "additionalProperties": true },
    "policyCommitments": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["schemaId", "digest"], "properties": { "schemaId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$" }, "digest": { "$ref": "#/$defs/digest" } } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["recipeId", "beforeStateDigest"], "properties": { "recipeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._~:/#-]{0,511}$" }, "beforeStateDigest": { "$ref": "#/$defs/digest" } } },
    "controlledCut": { "type": "object", "additionalProperties": false, "required": ["case"], "properties": { "case": { "const": "ambiguous-after-dispatch" } } },
    "runnerManifestDigest": { "$ref": "#/$defs/digest" },
    "testManifestDigest": { "$ref": "#/$defs/digest" },
    "endpointManifestDigest": { "$ref": "#/$defs/digest" },
    "runnerRegistryDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
