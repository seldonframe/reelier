{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/authority/tool-effect-contract/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "contractId", "provider", "operation", "operationDigest", "schemaDigest", "policyDigest", "effectClass", "model", "bindings", "semanticIdentity", "idempotencyKey", "readback", "result", "maximumEvidenceGrade"],
  "properties": {
    "v": { "const": "reelier.tool-effect-contract/v1" },
    "contractId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "operationDigest": { "$ref": "#/$defs/digest" }, "schemaDigest": { "$ref": "#/$defs/digest" }, "policyDigest": { "$ref": "#/$defs/digest" },
    "effectClass": { "enum": ["read", "idempotent-write", "destructive"] },
    "model": { "type": "object", "additionalProperties": false, "required": ["fields", "maxBytes"], "properties": { "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "maxBytes": { "type": "integer", "minimum": 0 } } },
    "bindings": { "type": "object", "additionalProperties": false, "required": ["credentialRef", "accountRef", "destinationRef", "limitRef"], "properties": { "credentialRef": { "type": "string" }, "accountRef": { "type": "string" }, "destinationRef": { "type": "string" }, "limitRef": { "type": "string" } } },
    "semanticIdentity": { "type": "string", "minLength": 1 }, "idempotencyKey": { "type": ["string", "null"] },
    "readback": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["operation", "projection"], "properties": { "operation": { "type": "string", "minLength": 1 }, "projection": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$" } } } }] }, "result": { "type": "object" },
    "maximumEvidenceGrade": { "enum": ["verified", "partial", "pending", "absent", "failed"] }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
