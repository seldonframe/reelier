{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"reelier.authority/authority-receipt/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["v","receiptId","gateEventDigest","decisionContextDigest","decisionContext","claims"],
  "properties":{
    "v":{"const":"reelier.authority-receipt/v1"},
    "receiptId":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},
    "gateEventDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "decisionContextDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "evidenceDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "priorReceiptDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},
    "decisionContext":{"type":"object","additionalProperties":false,"required":["v","tenant","requester","definitionAlias","requestId","requestDigest","requestKey","contractDigest","capabilityId","capabilityDigest","outcomeKey","effectDigest","snapshots"],"properties":{"v":{"const":"reelier.decision-context/v1"},"tenant":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},"requester":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},"definitionAlias":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,127}$"},"requestId":{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"},"requestDigest":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},"requestKey":{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"},"contractDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},"capabilityId":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[A-Za-z0-9._~-]{1,128}$"}]},"capabilityDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},"outcomeKey":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},"effectDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},"snapshots":{"type":"object","additionalProperties":false,"required":["sourceBundleDigest","authorityStateDigest"],"properties":{"sourceBundleDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]},"authorityStateDigest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:(?!0{64}$)[0-9a-f]{64}$"}]}}}}},
    "claims":{"type":"object","additionalProperties":false,"required":["authorization","sourceCompleteness","dispatch","providerAcknowledgment","reconciliation","topology","completeness"],"properties":{
      "authorization":{"enum":["verified","failed","unchecked","absent"]},
      "sourceCompleteness":{"enum":["verified","failed","unchecked","absent"]},
      "dispatch":{"enum":["verified","failed","unchecked","absent"]},
      "providerAcknowledgment":{"enum":["verified","failed","unchecked","absent"]},
      "reconciliation":{"enum":["verified","failed","unchecked","absent"]},
      "topology":{"enum":["verified","failed","unchecked","absent"]},
      "completeness":{"enum":["verified","failed","unchecked","absent"]}
    }}
  }
}
