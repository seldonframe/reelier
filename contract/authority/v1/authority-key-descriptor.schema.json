{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reelier.authority-key-descriptor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "keyId", "role", "purpose", "algorithm", "publicKeySpkiBase64"],
  "properties": {
    "v": { "const": "reelier.authority-key-descriptor/v1" },
    "keyId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,127}$" },
    "role": { "enum": ["human-sponsor", "authority-cell"] },
    "purpose": { "enum": ["certification-readiness", "authority-evidence", "authority-lease", "authority-receipt", "gate-event", "topology-evidence"] },
    "algorithm": { "const": "ed25519" },
    "publicKeySpkiBase64": { "type": "string", "minLength": 1, "contentEncoding": "base64" }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "human-sponsor" } }, "required": ["role"] },
      "then": { "properties": { "purpose": { "const": "certification-readiness" } } },
      "else": { "properties": { "purpose": { "enum": ["authority-evidence", "authority-lease", "authority-receipt", "gate-event", "topology-evidence"] } } }
    }
  ]
}
