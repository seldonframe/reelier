{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/contract/client/v1/authority-cell-connection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "endpoint", "transport", "bearerTokenRef", "expectedCellId", "adapterContractDigest"],
  "properties": {
    "v": { "const": "reelier.authority-cell-connection/v1" },
    "endpoint": { "type": "string", "minLength": 1 },
    "transport": { "const": "http" },
    "bearerTokenRef": { "type": "string", "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]{0,127}|file:.+)$" },
    "expectedCellId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "adapterContractDigest": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" }
  }
}
