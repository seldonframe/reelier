{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/contracts/aggregate-conformance/v0/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "status", "harnesses"],
  "properties": {
    "v": { "const": "reelier.aggregate-conformance-report/v0" },
    "status": { "enum": ["passed", "failed"] },
    "harnesses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/harness" } }
  },
  "allOf": [{
    "if": { "type": "object", "properties": { "status": { "const": "passed" } }, "required": ["status"] },
    "then": { "type": "object", "properties": { "harnesses": { "type": "array", "items": { "$ref": "#/$defs/passingHarness" } } } }
  }],
  "$defs": {
    "agentAdapterSourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "status", "adapterId", "checks"],
      "properties": {
        "v": { "const": "reelier.agent-adapter-conformance-report/v0" },
        "status": { "enum": ["passed", "failed"] },
        "adapterId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "$ref": "#/$defs/universalOperationsCheck" },
            { "$ref": "#/$defs/dynamicJobDiscoveryCheck" },
            { "$ref": "#/$defs/hostBoundOutcomeInputCheck" },
            { "$ref": "#/$defs/attenuatedChildPrincipalCheck" },
            { "$ref": "#/$defs/preFreezeNoDispatchCheck" },
            { "$ref": "#/$defs/observedCoverageHonestyCheck" },
            { "$ref": "#/$defs/enforcedModeUnavailableCheck" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
          "then": { "properties": { "checks": { "type": "array", "items": { "type": "object", "properties": { "status": { "const": "passed" } }, "required": ["status"] } } } }
        },
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "properties": { "checks": { "type": "array", "contains": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "minContains": 1 } } }
        }
      ]
    },
    "universalOperationsCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "universal-operations" }, "detail": { "const": "adapter exposes only the universal semantic operation set" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "universal-operations" }, "detail": { "const": "adapter operation set is missing, widened, or hard-coded" } } }
      ]
    },
    "dynamicJobDiscoveryCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "dynamic-job-discovery" }, "detail": { "const": "loaded and invoked job references originate in catalog discovery" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "dynamic-job-discovery" }, "detail": { "const": "job reference was not preserved from catalog discovery" } } }
      ]
    },
    "hostBoundOutcomeInputCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "host-bound-outcome-input" }, "detail": { "const": "Outcome input contains no authenticated identity or provider authority" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "host-bound-outcome-input" }, "detail": { "const": "Outcome input contains an identity or provider-authority override" } } }
      ]
    },
    "attenuatedChildPrincipalCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "attenuated-child-principal" }, "detail": { "const": "child principal and effect allocation are distinct and narrower" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "attenuated-child-principal" }, "detail": { "const": "child delegation does not attenuate the parent session" } } }
      ]
    },
    "preFreezeNoDispatchCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "pre-freeze-no-dispatch" }, "detail": { "const": "pending Adapter Contract refuses without dispatch or a passing receipt" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "pre-freeze-no-dispatch" }, "detail": { "const": "pre-freeze lifecycle implies dispatch, success, or upgraded evidence" } } }
      ]
    },
    "observedCoverageHonestyCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "observed-coverage-honesty" }, "detail": { "const": "observed mode remains available with unchecked topology and completeness" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "observed-coverage-honesty" }, "detail": { "const": "observed mode upgrades topology or completeness" } } }
      ]
    },
    "enforcedModeUnavailableCheck": {
      "oneOf": [
        { "type": "object", "$ref": "#/$defs/passedAgentCheck", "properties": { "id": { "const": "enforced-mode-unavailable" }, "detail": { "const": "enforced mode remains unavailable without verified topology" } } },
        { "type": "object", "$ref": "#/$defs/failedAgentCheck", "properties": { "id": { "const": "enforced-mode-unavailable" }, "detail": { "const": "enforced mode activates or upgrades claims before topology verifies" } } }
      ]
    },
    "passedAgentCheck": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "detail"],
      "properties": { "id": { "type": "string" }, "status": { "const": "passed" }, "detail": { "type": "string" } }
    },
    "failedAgentCheck": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "detail"],
      "properties": { "id": { "type": "string" }, "status": { "const": "failed" }, "detail": { "type": "string" } }
    },
    "evidence": { "enum": ["fixture-only", "continuity-only", "continuity-proven", "execution-proven", "unsupported", "failed"] },
    "coverage": { "enum": ["observed-only", "coverage-unknown", "unknown", "uncovered", "unchecked", "enforced", "unsupported", "failed"] },
    "execution": { "enum": ["execution-proven", "unknown", "unchecked", "pending", "not-tested", "unsupported", "failed"] },
    "outcome": { "enum": ["verified", "unknown", "unchecked", "absent", "pending", "not-tested", "unsupported", "failed"] },
    "overall": { "enum": ["fixture-only", "continuity-only", "continuity-proven", "execution-proven", "unknown", "uncovered", "unchecked", "absent", "pending", "not-tested", "unsupported", "failed"] },
    "nonClaims": {
      "type": "object", "additionalProperties": false,
      "required": ["routeEnforcement", "agentAdapterExecution", "liveHarnessExecution", "outcomeCorrectness", "productionSafety"],
      "properties": {
        "routeEnforcement": { "const": "not-proved" },
        "agentAdapterExecution": { "const": "not-proved" },
        "liveHarnessExecution": { "const": "not-proved" },
        "outcomeCorrectness": { "const": "not-proved" },
        "productionSafety": { "const": "not-proved" }
      }
    },
    "harnessProperties": {
      "type": "object", "additionalProperties": false,
      "required": ["harnessId", "adapterPath", "evidenceMaturity", "coverageStatus", "executionStatus", "outcomeStatus", "overallStatus", "nonClaims", "reasons"],
      "properties": {
        "harnessId": { "type": "string", "minLength": 1 },
        "adapterPath": { "type": "string", "minLength": 1 },
        "evidenceMaturity": { "$ref": "#/$defs/evidence" },
        "coverageStatus": { "$ref": "#/$defs/coverage" },
        "executionStatus": { "$ref": "#/$defs/execution" },
        "outcomeStatus": { "$ref": "#/$defs/outcome" },
        "overallStatus": { "$ref": "#/$defs/overall" },
        "nonClaims": { "$ref": "#/$defs/nonClaims" },
        "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "harness": {
      "allOf": [
        { "$ref": "#/$defs/harnessProperties" },
        { "if": { "type": "object", "properties": { "overallStatus": { "const": "fixture-only" } }, "required": ["overallStatus"] }, "then": { "type": "object", "properties": { "evidenceMaturity": { "const": "fixture-only" }, "coverageStatus": { "const": "observed-only" }, "executionStatus": { "const": "not-tested" }, "outcomeStatus": { "const": "not-tested" } } } },
        { "if": { "type": "object", "properties": { "overallStatus": { "const": "continuity-proven" } }, "required": ["overallStatus"] }, "then": { "type": "object", "properties": { "evidenceMaturity": { "const": "continuity-proven" }, "coverageStatus": { "const": "coverage-unknown" }, "executionStatus": { "const": "not-tested" }, "outcomeStatus": { "const": "not-tested" } } } },
        { "if": { "type": "object", "properties": { "overallStatus": { "const": "unsupported" } }, "required": ["overallStatus"] }, "then": { "type": "object", "properties": { "evidenceMaturity": { "const": "unsupported" }, "coverageStatus": { "const": "coverage-unknown" }, "executionStatus": { "const": "not-tested" }, "outcomeStatus": { "const": "not-tested" } } } },
        { "if": { "type": "object", "properties": { "overallStatus": { "const": "failed" } }, "required": ["overallStatus"] }, "then": { "type": "object", "properties": { "evidenceMaturity": { "const": "failed" }, "coverageStatus": { "const": "failed" }, "executionStatus": { "const": "failed" }, "outcomeStatus": { "const": "failed" } } } }
        ,{ "if": { "type": "object", "properties": { "overallStatus": { "const": "execution-proven" } }, "required": ["overallStatus"] }, "then": { "type": "object", "properties": { "evidenceMaturity": { "const": "execution-proven" }, "coverageStatus": { "const": "enforced" }, "executionStatus": { "const": "execution-proven" }, "outcomeStatus": { "const": "verified" } } } }
      ]
    },
    "passingHarness": {
      "allOf": [
        { "$ref": "#/$defs/harnessProperties" },
        { "type": "object", "properties": { "evidenceMaturity": { "const": "execution-proven" }, "coverageStatus": { "const": "enforced" }, "executionStatus": { "const": "execution-proven" }, "outcomeStatus": { "const": "verified" }, "overallStatus": { "const": "execution-proven" } } }
      ]
    }
  }
}
