{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reelier.dev/contracts/semantic-matrix-conformance/v0/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "status", "aggregate", "harnesses", "semanticChecks", "continuityEvidence"],
  "properties": {
    "v": { "const": "reelier.semantic-matrix-report/v0" },
    "status": { "enum": ["passed", "failed"] },
    "aggregate": { "$ref": "https://reelier.dev/contracts/aggregate-conformance/v0/report.schema.json" },
    "harnesses": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": { "allOf": [
        { "$ref": "https://reelier.dev/contracts/aggregate-conformance/v0/report.schema.json#/$defs/harness" },
        { "type": "object", "properties": { "harnessId": { "enum": ["codex", "claude-code", "eve", "grok-build", "grok-bot"] } } }
      ] },
      "allOf": [
        { "contains": { "type": "object", "properties": { "harnessId": { "const": "codex" } }, "required": ["harnessId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "harnessId": { "const": "claude-code" } }, "required": ["harnessId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "harnessId": { "const": "eve" } }, "required": ["harnessId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "harnessId": { "const": "grok-build" } }, "required": ["harnessId"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "harnessId": { "const": "grok-bot" } }, "required": ["harnessId"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "semanticChecks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "continuityEvidence": {
      "type": "array", "maxItems": 1,
      "items": { "allOf": [
        { "$ref": "https://reelier.dev/contracts/aggregate-conformance/v0/report.schema.json#/$defs/harness" },
        {
          "type": "object",
          "properties": {
            "harnessId": { "const": "eve" },
            "adapterPath": { "const": "continuity-adapter/v1/eve-fixture" }
          },
          "required": ["harnessId", "adapterPath"]
        }
      ] }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnessId", "id", "status", "detail"],
      "properties": {
        "harnessId": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "aggregate": { "type": "object", "properties": { "status": { "const": "passed" } }, "required": ["status"] } }, "required": ["aggregate"] }, "then": { "type": "object", "properties": { "status": { "const": "passed" } } } },
    { "if": { "properties": { "aggregate": { "type": "object", "properties": { "status": { "const": "failed" } }, "required": ["status"] } }, "required": ["aggregate"] }, "then": { "type": "object", "properties": { "status": { "const": "failed" } } } },
    { "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] }, "then": { "type": "object", "properties": { "harnesses": { "type": "array", "items": { "$ref": "https://reelier.dev/contracts/aggregate-conformance/v0/report.schema.json#/$defs/passingHarness" } } } } }
  ]
}
